# --- Base Stage ---
FROM node:20-alpine AS base
# Install OpenSSL for Prisma
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

# --- Dependencies Stage ---
FROM base AS deps
COPY package.json package-lock.json* ./
COPY prisma ./prisma
# Install dependencies and generate Prisma client
RUN npm ci
RUN npx prisma generate

# --- Development Stage ---
# This is the target triggered by docker-compose.override.yml
FROM base AS development
COPY --from=deps /app/node_modules ./node_modules
# We copy package files and prisma to ensure commands run correctly
COPY package.json ./
COPY prisma ./prisma
ENV NODE_ENV=development
# The command 'npm run dev' is executed by the docker-compose.override.yml command

# --- Builder Stage ---
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Generate Prisma Client again just in case, then build the Next app
RUN npx prisma generate
RUN npm run build

# --- Production Stage ---
# This is the target triggered by docker-compose.prod.yml
FROM base AS production
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy the standalone output generated by Next.js
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
# Copy Prisma for migrations triggered in docker-compose.prod.yml
COPY --from=builder /app/prisma ./prisma
COPY --from=deps /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=deps /app/node_modules/prisma ./node_modules/prisma

# Expose port (metadata)
EXPOSE 3000

# The command is provided by docker-compose.prod.yml:
# sh -c "npx prisma migrate deploy && node server.js"
