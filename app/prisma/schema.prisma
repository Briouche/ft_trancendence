generator client {
  provider = "prisma-client-js"
  adapter  = "@prisma/adapter-pg"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  // Stored lower-cased.
  email    String @unique
  username String @unique

  // Null for OAuth-only accounts.
  password String?

  // 42 intra id, set by "Sign in with 42".
  fortyTwoId Int? @unique

  // A JWT is only accepted if its tokenVersion matches (bump to log out everywhere).
  tokenVersion Int @default(0)

  // File name of an uploaded avatar (served by /api/avatars/[file]); null = default avatar.
  avatar String?

  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  createdAt     DateTime   @default(now())
  decks         Deck[]
  cards         UserCard[]
  unopenedPacks Int        @default(0)
  pityCounter   Int        @default(0)
  // Win counters per opponent type (GameSession.recordResult).
  winsVsAiEasy   Int @default(0)
  winsVsAiMedium Int @default(0)
  winsVsAiHard   Int @default(0)
  winsVsPlayer   Int @default(0)
  // Elo rating, PvP only (K = 32).
  elo Int @default(1000)
  // Selected / unlocked card backs, indices into lib/cardBacks.ts.
  cardBack          Int   @default(0)
  unlockedCardBacks Int[] @default([0, 1, 2])
  // Lifetime number of packs opened (achievements).
  packsOpened Int @default(0)

  messagesSent     Message[]         @relation("MessageSender")
  messagesReceived Message[]         @relation("MessageRecipient")
  achievements     UserAchievement[]
  matchesAsPlayer  MatchPlayer[]
}

// Online presence is not stored here: it lives in Redis (socket-server tracks connected users,
// game_engine tracks users in a match) because it changes constantly and is lost on restart
// anyway. See app/lib/presence.ts.

// Direct message between two friends (chat).
model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId Int
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String   @db.VarChar(500)
  createdAt   DateTime @default(now())

  @@index([senderId, recipientId, id])
  @@index([recipientId, senderId, id])
}

// Achievement unlocked by a user; the catalog (titles, thresholds, rewards) is code, in
// app/lib/achievements.ts, keyed by `key`.
model UserAchievement {
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@id([userId, key])
}

enum MatchMode {
  PVP
  AI_EASY
  AI_MEDIUM
  AI_HARD
}

// One finished match, written by game_engine (GameSession.recordResult).
model Match {
  id        Int           @id @default(autoincrement())
  mode      MatchMode
  // "hero" when a hero reached 0 HP, "forfeit" when a player quit or didn't reconnect in time.
  endReason String
  createdAt DateTime      @default(now())
  players   MatchPlayer[]
}

// A human seat of a Match (an AI seat has no row).
model MatchPlayer {
  matchId   Int
  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    Int
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  won       Boolean
  // Elo change applied by this match (PvP only, 0 otherwise).
  eloChange Int     @default(0)

  @@id([matchId, userId])
  @@index([userId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id     Int              @id @default(autoincrement())
  status FriendshipStatus @default(PENDING)

  requesterId Int
  requester   User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId Int
  addressee   User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

enum Keyword {
  RUEE
  RALE_DAGONIE
  CRI_DE_GUERRE
  REGENERATION
  AVENTURIER
  TAUNT
  SOIGNE
  VOL_DE_VIE
  SILENCE
}

// Card catalog; effect columns hold JSON specs (game_engine cardImport/effectFactory.ts).
model Card {
  id       String     @id
  assetKey String     @default("placeholder_card")
  artist   String?
  name     String
  type     String     @default("")
  rarity   String
  cost     String
  atk      String
  def      String
  desc     String
  qty      Int        @default(1)
  legendId String     @default("")
  decks    DeckCard[]

  taunt        Boolean?
  rush         Boolean?
  cannotAttack Boolean?
  archi        Boolean?
  spellpower   Int?

  battlecry         Json?
  deathrattle       Json?
  onAttack          Json?
  onDamage          Json?
  startOfTurnEffect Json?
  endOfTurnEffect   Json?
  spellEffect       Json?

  keywords Keyword[] @default([])
  owners   UserCard[]
}

// Copies owned by a player, capped by Card.qty.
model UserCard {
  userId Int
  cardId String
  qty    Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])
  card   Card   @relation(fields: [cardId], references: [id])

  @@id([userId, cardId])
}

model Deck {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     DeckCard[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model DeckCard {
  deckId Int
  cardId String
  qty    Int    @default(1)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@id([deckId, cardId])
  @@index([cardId])
}
