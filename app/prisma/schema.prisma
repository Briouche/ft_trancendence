// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  adapter  = "@prisma/adapter-pg"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  // lower case all email addresses and usernames when using them
  email    String @unique
  username String @unique

  // Nullable because OAuth-only accounts never set one
  password String?

  // 42 intra user id — set once the account is linked via "Sign in with 42".
  // Nullable/unique: most accounts won't have one, but no two can share the same.
  fortyTwoId Int? @unique

  // Used to logout-everywhere, password change, or suspected compromise
  // A JWT is only accepted if its embedded tokenVersion matches this value
  tokenVersion Int @default(0)

  createdAt     DateTime   @default(now())
  decks         Deck[]
  cards         UserCard[]
  unopenedPacks Int        @default(0)
  pityCounter   Int        @default(0)
  // Aucun mode de jeu live n'existe encore : reste à 0 pour tout le monde pour l'instant, prêt
  // à être incrémenté une fois qu'une partie peut se terminer.
  wins          Int        @default(0)
  // Index (0-19) dans le catalogue de dos de carte cosmétiques — voir lib/cardBacks.ts.
  cardBack      Int        @default(0)
  // Designs de dos de carte débloqués (index 0 offert d'office à tout le monde) — les autres
  // s'obtiennent en paquet, comme un drop rare (voir lib/packs.ts).
  unlockedCardBacks Int[]  @default([0])
}

enum Keyword {
  RUEE
  RALE_DAGONIE
  CRI_DE_GUERRE
  REGENERATION
  AVENTURIER
  TAUNT
  SOIGNE
  VOL_DE_VIE
  SILENCE
}

model Card {
  id       String @id
  name     String
  type     String @default("")
  rarity   String
  cost     String
  costNum  Int    @default(0)
  atk      String
  def      String
  desc     String
  qty      Int    @default(1)
  emoji    String @default("")
  color    String @default("")
  legendId String @default("")
  keywords Keyword[] @default([])
  decks    DeckCard[]
  owners   UserCard[]
}

// Carte(s) possédée(s) par un joueur. qty est plafonné par Card.qty
// (le nombre maximum d'exemplaires qu'un joueur peut posséder de cette carte).
model UserCard {
  userId Int
  cardId String
  qty    Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])
  card   Card   @relation(fields: [cardId], references: [id])

  @@id([userId, cardId])
}

model Deck {
    id        Int        @id @default(autoincrement())
    name      String
    userId    Int
    user      User       @relation(fields: [userId], references: [id])
    cards     DeckCard[]
    createdAt DateTime   @default(now())
}

model DeckCard {
    deckId Int
    cardId String
    qty    Int    @default(1)
    deck   Deck   @relation(fields: [deckId], references: [id])
    card   Card   @relation(fields: [cardId], references: [id])

    @@id([deckId, cardId])
}
