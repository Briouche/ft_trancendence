generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password      String
  name          String?
  createdAt     DateTime   @default(now())
  decks         Deck[]
  cards         UserCard[]
  unopenedPacks Int        @default(0)
  pityCounter   Int        @default(0)
}

enum Keyword {
  RUEE
  RALE_DAGONIE
  CRI_DE_GUERRE
  REGENERATION
  AVENTURIER
  TAUNT
  SOIGNE
  VOL_DE_VIE
  SILENCE
}

model Card {
  id       String @id
  name     String
  type     String @default("")
  rarity   String
  cost     String
  costNum  Int    @default(0)
  atk      String
  def      String
  desc     String
  qty      Int    @default(1)
  emoji    String @default("")
  color    String @default("")
  legendId String @default("")
  keywords Keyword[] @default([])
  decks    DeckCard[]
  owners   UserCard[]
}

// Carte(s) possédée(s) par un joueur. qty est plafonné par Card.qty
// (le nombre maximum d'exemplaires qu'un joueur peut posséder de cette carte).
model UserCard {
  userId Int
  cardId String
  qty    Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])
  card   Card   @relation(fields: [cardId], references: [id])

  @@id([userId, cardId])
}

model Deck {
    id        Int        @id @default(autoincrement())
    name      String
    userId    Int
    user      User       @relation(fields: [userId], references: [id])
    cards     DeckCard[]
    createdAt DateTime   @default(now())
}

model DeckCard {
    deckId Int
    cardId String
    qty    Int    @default(1)
    deck   Deck   @relation(fields: [deckId], references: [id])
    card   Card   @relation(fields: [cardId], references: [id])

    @@id([deckId, cardId])
}
