// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  adapter  = "@prisma/adapter-pg"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  // lower case all email addresses and usernames when using them
  email    String @unique
  username String @unique

  // Nullable because OAuth-only accounts never set one
  password String?

  // 42 intra user id — set once the account is linked via "Sign in with 42".
  // Nullable/unique: most accounts won't have one, but no two can share the same.
  fortyTwoId Int? @unique

  // Used to logout-everywhere, password change, or suspected compromise
  // A JWT is only accepted if its embedded tokenVersion matches this value
  tokenVersion Int @default(0)

  createdAt     DateTime   @default(now())
  decks         Deck[]
  cards         UserCard[]
  unopenedPacks Int        @default(0)
  pityCounter   Int        @default(0)
  // Décomptées séparément par type d'adversaire — voir GameSession.recordResult (gameEngine) qui
  // incrémente le bon compteur à la fin de chaque partie, selon le seat en face (IA + sa
  // difficulté, ou un vrai joueur).
  winsVsAiEasy   Int @default(0)
  winsVsAiMedium Int @default(0)
  winsVsAiHard   Int @default(0)
  winsVsPlayer   Int @default(0)
  // Index (0-7) dans le catalogue de dos de carte cosmétiques — voir lib/cardBacks.ts.
  cardBack      Int        @default(0)
  // Designs de dos de carte débloqués (index 0-2 offerts d'office à tout le monde) — les 5
  // restants (3-7) sont réservés à un haut fait précis, jamais offerts ni tirables en paquet
  // (voir ACHIEVEMENT_CARD_BACKS dans lib/cardBacks.ts et packs.ts).
  unlockedCardBacks Int[]  @default([0, 1, 2])
}

enum Keyword {
  RUEE
  RALE_DAGONIE
  CRI_DE_GUERRE
  REGENERATION
  AVENTURIER
  TAUNT
  SOIGNE
  VOL_DE_VIE
  SILENCE
}

// ─────────────────────────────────────────────
// Game Component Models
// ─────────────────────────────────────────────

model Card {
  id       String     @id
  assetKey String     @default("placeholder_card")
  artist   String?
  name     String
  type     String     @default("")
  rarity   String
  cost     String
  atk      String
  def      String
  desc     String
  qty      Int        @default(1)
  legendId String     @default("")
  decks    DeckCard[]

  taunt        Boolean?
  rush         Boolean?
  cannotAttack Boolean?
  archi        Boolean?
  spellpower   Int?

  battlecry         Json?
  deathrattle       Json?
  onAttack          Json?
  onDamage          Json?
  startOfTurnEffect Json?
  endOfTurnEffect   Json?
  spellEffect       Json?
  
  keywords Keyword[] @default([])
  owners   UserCard[]
}

// Carte(s) possédée(s) par un joueur. qty est plafonné par Card.qty
// (le nombre maximum d'exemplaires qu'un joueur peut posséder de cette carte).
model UserCard {
  userId Int
  cardId String
  qty    Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])
  card   Card   @relation(fields: [cardId], references: [id])

  @@id([userId, cardId])
}


model Deck {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     DeckCard[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model DeckCard {
  deckId Int
  cardId String
  qty    Int    @default(1)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@id([deckId, cardId])
  @@index([cardId])
}
