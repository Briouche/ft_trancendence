map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Docker's DNS, re-resolved every 10s. Upstreams are proxied through variables below rather than
# `upstream` blocks, which nginx resolves only once at startup: a recreated container comes back
# with a new IP, and nginx would keep sending to the old one (502) until it was restarted itself.
resolver 127.0.0.11 valid=10s;

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    location / {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Next.js app
	location @nextjs {
		set $nextjs_upstream app:3000;
		proxy_pass http://$nextjs_upstream;
		proxy_http_version 1.1;
		proxy_set_header Host                $http_host;
		proxy_set_header X-Forwarded-Host    $http_host;
		proxy_set_header X-Real-IP           $remote_addr;
		proxy_set_header X-Forwarded-For     $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto   $scheme;

		# A bit more headroom than nginx's 60s default for slow/low-core hardware.
		proxy_read_timeout 90s;
		proxy_send_timeout 90s;
	}

    # Immutable build assets, served from disk
    location /_next/static/ {
        alias /var/www/html/_next/static/;
        expires 1y;
        access_log off;
        # Any add_header here replaces (not extends) the server-level ones, so they're repeated.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-XSS-Protection "1; mode=block";
        add_header X-Content-Type-Options "nosniff";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri $uri/ @nextjs;
    }

    # public/ files from disk, everything else to Next.js
    location / {
        root /var/www/html;
        try_files /public$uri @nextjs;
    }

    # Game server (game_engine) socket.io
    location /socket.io/ {
        set $game_engine_upstream game_engine:4000;
        proxy_pass http://$game_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $http_host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Chat/presence server (socket-server) socket.io
    location /chat-socket.io/ {
        set $socketio_upstream socketio:4000;
        proxy_pass http://$socketio_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $http_host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
