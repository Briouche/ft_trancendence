# 1. WebSocket mapping (Allowed in http block scope)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream nextjs_upstream {
    server app:3000;
}

upstream game_engine_upstream {
    server game_engine:4000;
}

# 2. HTTP to HTTPS Redirect
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    location / {
        return 301 https://$host$request_uri;
    }
}

# 3. HTTPS Server Block
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Reusable proxy target fallback
    location @nextjs {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host                $host;
        proxy_set_header X-Real-IP           $remote_addr;
        proxy_set_header X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto   $scheme;
    }

    # Serve Next.js Immutable Static Files directly from disk
    location /_next/static/ {
        alias /var/www/html/_next/static/;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri $uri/ @nextjs;
    }

    # Dynamic Next.js Routes, SSR, and public/ assets (favicon.ico, images/, robots.txt, etc.)
    # Next.js serves public/ contents at the URL root, so we check the mounted
    # public/ volume first for any path, and fall back to Next.js if it's not
    # a static file (i.e. it's an actual route).
    location / {
        root /var/www/html;
        try_files /public$uri @nextjs;
    }

    # WebSocket connections — the game server (gameEngine/, its own Node process, not the
    # Next.js app) speaks socket.io on its own port; proxied here under the same origin.
    location /socket.io/ {
        proxy_pass http://game_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
