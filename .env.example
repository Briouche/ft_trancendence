# Template only: copy to .env (`cp .env.example .env`) and fill in the values.
# Never put real secrets in this file: it is committed. .env itself is git-ignored.

#── Sessions ──────────────────────────────────────────────────────────────────
# Signs the session JWT (HS256), shared by app, game_engine and socket-server.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

#── Public domain (production mode, `make prod`) ──────────────────────────────
# Must match the domain nginx generates its self-signed cert for and serves as
# server_name in prod (see proxy/prod.conf.template) — mismatched values mean
# either a cert error or a 404 on every request. Unused by `make` (dev), which
# always serves https://localhost:8080.
DOMAIN_NAME=localhost

#── PostgreSQL ────────────────────────────────────────────────────────────────
# Created on the first start of the db container; changing them later needs
# `make fclean` (drops the database volume).
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=
POSTGRES_DB=transcendence

#── 42 OAuth ("Sign in with 42") ──────────────────────────────────────────────
# From your application on https://profile.intra.42.fr/oauth/applications.
# The redirect URI registered there must be exactly FT_REDIRECT_URI:
#   dev  (make)      → https://localhost:8080/api/auth/42/callback
#   prod (make prod) → https://<DOMAIN_NAME>/api/auth/42/callback
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=https://localhost:8080/api/auth/42/callback
