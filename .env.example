# Copy to .env (never committed: .env is git-ignored) and fill in the blanks.

#── Sessions ──────────────────────────────────────────────────────────────────
# Signs the session JWT (app) and is not shared with the browser. Use a long random value, e.g.
#   openssl rand -base64 48
JWT_SECRET=

#── Domain / TLS ──────────────────────────────────────────────────────────────
# Production only (`make prod`): the domain nginx generates its self-signed certificate for and
# serves as server_name (see proxy/prod.conf.template). Development always runs on
# https://localhost:8080.
DOMAIN_NAME=localhost

#── PostgreSQL ────────────────────────────────────────────────────────────────
# Credentials of the database container; the services build DATABASE_URL from them.
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transcendence

#── 42 OAuth ("Sign in with 42") ──────────────────────────────────────────────
# From the application you create at https://profile.intra.42.fr/oauth/applications. The
# redirect URI registered there must be exactly FT_REDIRECT_URI. Leave these empty to run
# without "Sign in with 42" (the button then shows an error message).
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=https://localhost:8080/api/auth/42/callback
