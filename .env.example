JWT_SECRET=9RRsNkP+1qhs6fgBTipLPASiLghq9I8YOYEhT82lfTE=

# Must match the domain nginx generates its self-signed cert for and serves as
# server_name in prod (see proxy/prod.conf.template) — mismatched values mean
# either a cert error or a 404 on every request.
DOMAIN_NAME=jeudecartes.super.be

#── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=myuser
POSTGRES_PASSWORD=securePass
POSTGRES_DB=mydb

#── 42 OAuth ("Sign in with 42") ────────────────────────────────────────────────
FT_CLIENT_ID= u-s4t2ud-468bf32b474c181c17ececa85b388e9ceb32779b9923413a201279a11adaf632
FT_CLIENT_SECRET= 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

# Dev value below points at the local nginx proxy (localhost:8080). In prod this
# must be updated to https://${DOMAIN_NAME}/api/auth/42/callback, and that exact
# URL must also be registered as a redirect URI on the 42 OAuth app.
FT_REDIRECT_URI=http://localhost:8080/api/auth/42/callback