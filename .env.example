# Template only: copy to .env and fill in. Never put real secrets in this file (it is committed).
JWT_SECRET=

# Must match the domain nginx generates its self-signed cert for and serves as
# server_name in prod (see proxy/prod.conf.template) — mismatched values mean
# either a cert error or a 404 on every request.
DOMAIN_NAME=jeudecartes.super.be

#── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=myuser
POSTGRES_PASSWORD=
POSTGRES_DB=mydb

#── 42 OAuth ("Sign in with 42") ────────────────────────────────────────────────
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=
